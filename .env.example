APP_ENV=development
APP_NAME=ResumeIQ API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://resumeiq:resumeiq@localhost:5432/resumeiq
JWT_SECRET_KEY=replace-me-with-a-random-32-byte-key
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
VECTOR_DATABASE_URL=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional provider configuration; never commit real values.
LLM_PROVIDER=stub
LLM_API_KEY=
EMBEDDING_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
